window "Задачи" 480x560
state items list ""
state draft string ""
state done int "0"
theme dark accent:#388bfd round:8
label "Задачи" {size:24, bold}
label "сделано: {done} · в списке: {items}" {color:#8b949e, size:12}
hbox
  text_input "что сделать" -> draft {grow}
  button "Добавить" do append items draft; draft = "" {key:ctrl+enter, icon:check}
list "пусто — добавьте первую задачу" -> items
hbox
  button "Готово" do done += 1 {size:14}
  button "Сброс" do done = 0
  button "Очистить" do clear items; done = 0 {icon:delete}
