window "Доступ" 440x400
state code string ""
state tries int "0"
theme dark accent:#39d353 font:15 spacing:10 round:10
label "Доступ" {size:24, bold}
label "попыток: {tries}" {color:#8b949e, size:12}
text_input "введите код" -> code {grow}
hbox
  button "Проверить" do tries += 1 {key:ctrl+enter, icon:check}
  button "Сброс" do code = "" ; tries = 0
separator
when code == "42"
  label "открыто" {color:#39d353, size:22, bold}
when code != "42"
  label "закрыто" {color:#e5484d, size:18}
when tries >= 3
  label "подсказка: 42" {color:#ffb86b, size:12}
