; Чек-лист (строчная модель) — тот же шаблон строки, что и в checklist.lisp.
window "Чек-лист" 480 420
theme dark accent:#a371f7 font:15 spacing:8 round:8
state items list "хлеб,молоко"
state draft string
state added int 2
label "Чек-лист" {size:24, bold}
label "в списке: {items} · добавлено: {added}" {size:12, color:#8b949e}
hbox
  text-input "что взять" -> draft {grow}
  button "Добавить" do append items draft; draft = ""; added += 1 {icon:check}
separator
list -> items "пусто"
  hbox
    label "• {item}" {size:15, grow}
    button "убрать" do remove items {size:12, icon:delete}
separator
when added > 2
  label "записей больше двух" {size:12, color:#ffb86b}
else
  label "можно ещё" {size:12, color:#8b949e}
